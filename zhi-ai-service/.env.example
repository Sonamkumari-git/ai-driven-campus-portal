# === ZHI AI Microservice ===
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=development
AI_SERVICE_LOG_LEVEL=INFO

# Shared secret; Node backend must send this in header X-Internal-Key
AI_SERVICE_API_KEY=change-this-strong-random-key

# CORS: comma-separated origins for the Node backend
AI_CORS_ORIGINS=http://localhost:5000,https://your-node-service.onrender.com

# === MongoDB (same URI as Node.js ERP) ===
MONGO_URI=mongodb://127.0.0.1:27017/zhi_college
MONGO_DB_NAME=zhi_college

# === ML ===
ML_MODELS_DIR=./ml_models

# === OCR ===
# On Render (via Aptfile) tesseract lives at /usr/bin/tesseract
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANG=eng
